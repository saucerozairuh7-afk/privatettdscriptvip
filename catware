-- ============ DUPE LOGIC: FREE = VISUAL, VIP = FE ============
local function findMyUnits()
    local units = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") then table.insert(units, v) end
    end
    return units
end
local function visualDupe()
    -- FREE: Clone only on YOUR screen, server does NOT see it
    local units = findMyUnits()
    if #units == 0 then return "No unit found" end
    local target = units[1]
    local clone = target:Clone()
    clone.Parent = workspace
    if clone:FindFirstChild("HumanoidRootPart") then
        clone.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame + Vector3.new(3,0,0)
    end
    task.delay(3, function() pcall(function() clone:Destroy() end) end)
    return "Visual Dupe Done - Only you see it"
end
local function feDupe()
    -- VIP: Try to fire server Remote to actually dupe - if game patched, falls back to visual
    local success = false
    pcall(function()
        for _, rem in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if rem:IsA("RemoteEvent") and (rem.Name:lower():find("place") or rem.Name:lower():find("spawn") or rem.Name:lower():find("dupe")) then
                rem:FireServer("Dupe", 1)
                success = true
            end
        end
    end)
    if not success then
        visualDupe()
        return "FE Remote not found - used Visual fallback"
    end
    return "FE Dupe Fired - Check inventory"
end

