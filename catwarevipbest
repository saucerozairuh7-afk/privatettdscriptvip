local function setESP(on)
    pcall(function()
        for _, ch in pairs(ESPFolder:GetChildren()) do ch:Destroy() end
        if not on then return end
        for _, m in pairs(workspace:GetDescendants()) do
            if m:IsA("Model") and m:FindFirstChild("Humanoid") then
                local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                if hrp then
                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.new(0, 100, 0, 30)
                    bb.AlwaysOnTop = true
                    bb.Parent = ESPFolder
                    bb.Adornee = hrp
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1,0,1,0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = m.Name.." | HP: "..math.floor(m.Humanoid.Health)
                    lbl.TextColor3 = Color3.fromRGB(0,255,140)
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 11
                    lbl.Parent = bb
                end
            end
        end
    end)
end
-- Range visuals storage
local RangeFolder = Instance.new("Folder") RangeFolder.Name = "CatWareRange" RangeFolder.Parent = workspace
local function setRange(on)
    pcall(function()
        for _, ch in pairs(RangeFolder:GetChildren()) do ch:Destroy() end
        if not on then return end
        for _, m in pairs(workspace:GetDescendants()) do
            if m:IsA("Model") and m:FindFirstChild("Humanoid") then
                local hrp = m:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local cyl = Instance.new("Part")
                    cyl.Shape = Enum.PartType.Cylinder
                    cyl.Size = Vector3.new(0.2, 20, 20)
                    cyl.CFrame = hrp.CFrame * CFrame.new(0, -1.5, 0) * CFrame.Angles(0,0,math.rad(90))
                    cyl.Transparency = 0.7
                    cyl.Color = Color3.fromRGB(0,255,140)
                    cyl.CanCollide = false
                    cyl.Anchored = true
                    cyl.Parent = RangeFolder
                end
            end
        end
    end)
end
-- FPS Boost real
local origLighting = {}
local function setFPS(on)
    pcall(function()
        if on then
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then v.Enabled = false end
                if v:IsA("Decal") then v.Transparency = 1 end
            end
            local L = game:GetService("Lighting")
            L.GlobalShadows = false
            L.FogEnd = 100
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        else
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then v.Enabled = true end
                if v:IsA("Decal") then v.Transparency = 0 end
            end
            game:GetService("Lighting").GlobalShadows = true
        end
    end)
end

