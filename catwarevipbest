-- Build a real 3D model for preview: try to clone real game model, else build 3D rig from Parts (NOT emoji, NOT image)
local function build3DModel(unitName, rarity)
    local model = Instance.new("Model")
    model.Name = unitName
    local isTitan = unitName:lower():find("titan") ~= nil
    local scale = isTitan and 1.8 or 1
    local col = RARITY_COLOR[rarity] or Color3.fromRGB(200,200,200)
    -- Body
    local torso = Instance.new("Part")
    torso.Size = Vector3.new(1.2*scale, 1.4*scale, 0.7*scale)
    torso.Position = Vector3.new(0, 1.2*scale, 0)
    torso.Color = Color3.fromRGB(30,30,35)
    torso.Material = Enum.Material.SmoothPlastic
    torso.Parent = model
    -- Head = Camera / Speaker / TV depending on name
    local head = Instance.new("Part")
    head.Size = Vector3.new(1.1*scale, 0.9*scale, 0.9*scale)
    head.Position = Vector3.new(0, 2.4*scale, 0)
    if unitName:lower():find("speaker") then head.Color = Color3.fromRGB(20,20,20) head.Shape = Enum.PartType.Cylinder
    elseif unitName:lower():find("tv") then head.Color = Color3.fromRGB(10,10,15)
    elseif unitName:lower():find("clock") then head.Color = Color3.fromRGB(240,220,150) head.Shape = Enum.PartType.Cylinder
    elseif unitName:lower():find("drill") then head.Color = Color3.fromRGB(120,90,40)
    else head.Color = Color3.fromRGB(220,220,220) end
    head.Material = Enum.Material.SmoothPlastic
    head.Parent = model
    -- Lens / Screen - glowing
    local lens = Instance.new("Part")
    lens.Size = Vector3.new(0.6*scale, 0.5*scale, 0.1*scale)
    lens.Position = Vector3.new(0, 2.4*scale, 0.5*scale)
    lens.Color = col
    lens.Material = Enum.Material.Neon
    lens.Parent = model
    -- Arms
    for _, side in ipairs({-1, 1}) do
        local arm = Instance.new("Part")
        arm.Size = Vector3.new(0.35*scale, 1.1*scale, 0.35*scale)
        arm.Position = Vector3.new(side*0.85*scale, 1.2*scale, 0)
        arm.Color = Color3.fromRGB(40,40,45)
        arm.Parent = model
        local leg = Instance.new("Part")
        leg.Size = Vector3.new(0.45*scale, 0.9*scale, 0.45*scale)
        leg.Position = Vector3.new(side*0.35*scale, 0.15*scale, 0)
        leg.Color = Color3.fromRGB(25,25,30)
        leg.Parent = model
    end
    -- Titan shoulder pads / crown for Godly
    if isTitan or rarity=="Godly" or rarity=="Ultimate" then
        for _, side in ipairs({-1, 1}) do
            local pad = Instance.new("Part")
            pad.Size = Vector3.new(0.7*scale, 0.35*scale, 0.7*scale)
            pad.Position = Vector3.new(side*1.05*scale, 2.05*scale, 0)
            pad.Color = col
            pad.Material = Enum.Material.Metal
            pad.Parent = model
        end
    end
    local hrp = Instance.new("Part")
    hrp.Name = "HumanoidRootPart"
    hrp.Size = Vector3.new(1,1,1)
    hrp.Transparency = 1
    hrp.Position = Vector3.new(0, 1.2*scale, 0)
    hrp.Parent = model
    model.PrimaryPart = hrp
    return model
end

local function makeViewport(parent, unitName, rarity, size)
    local vp = Instance.new("ViewportFrame")
    vp.Size = size or UDim2.new(0, 70, 0, 70)
    vp.BackgroundColor3 = Color3.fromRGB(20,20,25)
    vp.BackgroundTransparency = 0.2
    vp.BorderSizePixel = 0
    vp.Parent = parent
    local vc = Instance.new("UICorner") vc.CornerRadius = UDim.new(0,10) vc.Parent = vp
    -- Try real game model first
    local realModel = nil
    pcall(function()
        for _, container in ipairs({game:GetService("ReplicatedStorage"), workspace}) do
            local f = container:FindFirstChild(unitName, true)
            if f and f:IsA("Model") then realModel = f:Clone() break end
        end
    end)
    local model = realModel or build3DModel(unitName, rarity)
    model.Parent = vp
    local cam = Instance.new("Camera")
    cam.Parent = vp
    vp.CurrentCamera = cam
    local cf, _ = model:GetBoundingBox()
    local center = cf.Position
    local ext = model:GetExtentsSize()
    local dist = math.max(ext.X, ext.Y, ext.Z) * 2.2
    cam.CFrame = CFrame.new(center + Vector3.new(0, 0.6, dist), center)
    -- Slow rotate - real 3D spin
    task.spawn(function()
        local a = 0
        while vp.Parent do
            a = a + 0.02
            pcall(function() model:PivotTo(CFrame.new(center) * CFrame.Angles(0, a, 0)) end)
            task.wait(0.03)
        end
    end)
    return vp
end

